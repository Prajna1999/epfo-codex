# Copy this file to .env.local and fill in your own key. .env.local is gitignored.

# Required — get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional — confirm the exact current model ID in your OpenAI dashboard before setting this.
# Leave unset to use @openai/agents' own default model.
OPENAI_MODEL=

# Voice IVR / Realtime SIP
PUBLIC_BASE_URL=http://localhost:3000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_IVR_NUMBER=
TWILIO_HUMAN_QUEUE_NUMBER=
OPENAI_WEBHOOK_SECRET=
OPENAI_PROJECT_ID=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=cedar
OPENAI_SIP_URI=
